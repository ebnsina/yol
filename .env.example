# Copy to .env and fill every value. The API refuses to start if any is missing
# or malformed — there are no fallback defaults.

# development | staging | production
YOL_ENV=development

YOL_HTTP_ADDR=:8080
YOL_PUBLIC_URL=http://localhost:8080

# Must be a NOSUPERUSER, NOBYPASSRLS role that does not own the tables. Owners and
# superusers bypass row level security, which would silently disable tenant isolation.
YOL_DATABASE_URL=postgres://yol_app:yol_app@localhost:5442/yol?sslmode=disable

# Generate each with: openssl rand -hex 32
YOL_SESSION_SECRET=
YOL_SECRETS_KEY=
YOL_AGENT_SPEC_KEY=

YOL_SHUTDOWN_TIMEOUT=15s
