# Copy to .env and fill every value. The API refuses to start if any is missing
# or malformed — there are no fallback defaults.

# development | staging | production
YOL_ENV=development

YOL_HTTP_ADDR=:8080
YOL_PUBLIC_URL=http://localhost:8080

# Origin of the web client, used for CORS. The browser calls the API directly.
YOL_WEB_ORIGIN=http://localhost:5173
# Parent domain the session cookie is scoped to.
YOL_COOKIE_DOMAIN=localhost

# Must be a NOSUPERUSER, NOBYPASSRLS role that does not own the tables. Owners and
# superusers bypass row level security, which would silently disable tenant isolation.
YOL_DATABASE_URL=postgres://yol_app:yol_app@localhost:5442/yol?sslmode=disable

# Generate each with: openssl rand -hex 32
YOL_SESSION_SECRET=
YOL_SECRETS_KEY=
YOL_AGENT_SPEC_KEY=

# Where the agent builds live, copied onto a server during setup.
YOL_AGENT_DIR=./bin

YOL_SESSION_TTL=720h
YOL_SHUTDOWN_TIMEOUT=15s

# Where code comes from. Create a GitHub App with contents:read and metadata:read, a
# webhook pointing at YOL_PUBLIC_URL/v1/github/deliveries, and the push and
# installation events. The private key may be pasted with real newlines or with \n.
YOL_GITHUB_APP_ID=
YOL_GITHUB_APP_SLUG=
YOL_GITHUB_PRIVATE_KEY=
# Generate with: openssl rand -hex 32
YOL_GITHUB_WEBHOOK_SECRET=

# The parent name free subdomains are handed out from, such as yol.app. Must be present and may
# be empty: empty means none are handed out, and an app is reached by the address of its server
# until somebody adds a hostname of their own. Fill this in once you own a domain.
YOL_APP_DOMAIN=

# Where GitHub is. The harness points this at a stand-in; leave it as the real thing.
YOL_GITHUB_API_URL=https://api.github.com

# Where a customer's server fetches code from. The same as YOL_GITHUB_API_URL unless their
# machines reach GitHub another way.
YOL_GITHUB_SOURCE_URL=https://api.github.com
